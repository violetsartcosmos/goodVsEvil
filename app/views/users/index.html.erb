<main class="container profile-page py-5">
  <section class="profile-hero card border-0 shadow-lg mb-4">
    <div class="profile-hero-art"></div>
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="text-uppercase small fw-semibold text-info mb-2">Good Vs Evil community</div>
        <h1 class="h2 fw-bold mb-1">User profiles</h1>
        <p class="text-body-secondary mb-0">Meet the people in your community.</p>
      </div>
      <%= link_to "Add user", new_user_path, class: "btn btn-info fw-semibold px-4" %>
    </div>
  </section>

  <section class="card profile-card border-0 shadow-lg">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Full name</th>
            <th scope="col">Username</th>
            <th scope="col">Email address</th>
            <th scope="col">Phone number</th>
            <th scope="col">Address</th>
            <th scope="col">Language</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= link_to [user.first_name, user.last_name].compact_blank.join(" ").presence || "-", user_path(user), class: "text-decoration-none fw-semibold" %></td>
              <td><%= user.username %></td>
              <td><%= user.email %></td>
              <td><%= user.phone.presence || "—" %></td>
              <td><%= user.address.presence || "—" %></td>
              <td><%= user.language.presence || "—" %></td>
              <td class="text-end text-nowrap">
                <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-outline-info me-1" %>
                <%= link_to "Delete", user_path(user), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this user?" }, class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
          <% if @users.empty? %>
            <tr>
              <td colspan="7" class="text-center text-body-secondary py-4">No users yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>