<main class="container">

  <section class="">
    <div class="position-relative mb-3">
      <%= search_field_tag :search, params[:search], class: "form-control w-100 rounded-4 ps-5", autofocus: true %>
      <i class="bi bi-search position-absolute top-50 start-0 ms-3 translate-middle-y text-body-secondary" aria-hidden="true"></i>
    </div>
    <div class="table-responsive">
      <table class="table table-black table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Username</th>
            <th scope="col">Email</th>
            <th scope="col" class="text-center">Active</th>
            <th scope="col" class="text-center">Level</th>
            <th scope="col" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>
              <td><%= link_to [user.first_name, user.last_name].compact_blank.join(" ").presence || "-", user_path(user), class: "text-decoration-none fw-semibold" %></td>
              <td class="truncate"><%= user.username %></td>
              <td class="truncate"><%= user.email %></td>
              <td class="text-center">
                <% if rand(1000000000..9999999999).even? %>
                  <i class="bi bi-check-circle-fill text-success"></i>
                <% else %>
                  <i class="bi bi-x-circle-fill text-danger"></i>
                <% end %>
              </td>
              <td class="text-center">
                <i class="bi bi-<%= rand(1..9) %>-circle-fill text-<%= ["info", "success", "warning", "danger"].sample %>"></i> 
              </td>
              <td class="text-center text-nowrap">
                <%= link_to edit_user_path(user), class: "btn btn-sm btn-outline-info me-1" do %>
                  <i class="bi bi-pencil-fill"></i>
                <% end %>
                <%= link_to user_path(user), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this user?" }, class: "btn btn-sm btn-outline-danger" do %>
                  <i class="bi bi-trash-fill"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @users.empty? %>
            <tr>
              <td colspan="7" class="text-center text-body-secondary py-4">No users yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</main>