<section class="tab-pane fade p-3 p-md-4" id="<%= key %>-bad" role="tabpanel" aria-labelledby="<%= key %>-bad-tab" tabindex="0">
  <ul class="nav nav-tabs showcase-explanation-tabs" role="tablist" aria-label="Bad design example and explanation">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="<%= key %>-bad-example-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-bad-example" type="button" role="tab" aria-controls="<%= key %>-bad-example" aria-selected="true">Bad Design</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="<%= key %>-bad-why-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-bad-why" type="button" role="tab" aria-controls="<%= key %>-bad-why" aria-selected="false">Why?</button>
    </li>
  </ul>

  <div class="tab-content showcase-explanation-content">
    <div class="tab-pane fade show active" id="<%= key %>-bad-example" role="tabpanel" aria-labelledby="<%= key %>-bad-example-tab" tabindex="0">
      <div class="showcase-preview demo-bad demo-bad-<%= key %>">
        <%= render bad_design_partial %>
      </div>
    </div>
    <div class="tab-pane fade" id="<%= key %>-bad-why" role="tabpanel" aria-labelledby="<%= key %>-bad-why-tab" tabindex="0">
      <aside class="showcase-takeaway showcase-takeaway-bad p-3 p-lg-4 rounded-bottom-3">
        <% if key == "inputs" %>
          <ol class="demo-behavior-list">
            <li>Changing what people type destroys trust and makes errors hard to fix.</li>
            <li>Tiny controls turn a simple task into a precision test.</li>
            <li>Unlabeled choices force people to guess.</li>
            <li>An action that cannot be used is not an action.</li>
            <li>A wall of identical buttons offers noise instead of direction.</li>
            <li>A control that changes on its own cannot be trusted.</li>
            <li>Rejecting the correct answer teaches people not to trust the form.</li>
            <li>Inconsistent labels compete for attention and erase hierarchy.</li>
            <li>Moving a target punishes anyone trying to use it.</li>
          </ol>
        <% else %>
          <p class="small mb-0"><%= description %></p>
        <% end %>
      </aside>
    </div>
  </div>
</section>
