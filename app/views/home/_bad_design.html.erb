<section class="tab-pane fade p-3 p-md-4" id="<%= key %>-bad" role="tabpanel" aria-labelledby="<%= key %>-bad-tab" tabindex="0">
  <div class="row g-4 align-items-stretch">
    <div class="col-12 col-md-7">
      <div class="showcase-preview demo-bad demo-bad-<%= key %> h-100">
        <%= render bad_design_partial %>
      </div>
    </div>
    <div class="col-12 col-md-5">
      <aside class="showcase-takeaway showcase-takeaway-bad h-100 p-3 p-lg-4 rounded-4">
        <h3 class="h5 mb-3">Why it’s hard to use</h3>
        <% if key == "inputs" %>
          <ol class="demo-behavior-list">
            <li>Fields scramble as you type and overflow in one cramped row.</li>
            <li>Phone, address, and language fields are only 1px wide and disabled.</li>
            <li>Ten unlabeled 5px checkboxes are packed close together.</li>
            <li>The actions are disabled; one has a nonsense caption and the other a broken image.</li>
          </ol>
        <% else %>
          <p class="small mb-0"><%= description %></p>
        <% end %>
      </aside>
    </div>
  </div>
</section>
