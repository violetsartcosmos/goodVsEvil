<div class="showcase-heading mb-4">
  <span class="small text-uppercase fw-semibold text-info">Explore the difference</span>
  <h2 class="display-6 fw-bold mt-2 mb-2"><%= title %></h2>
  <p class="text-body-secondary mb-0"><%= description %></p>
</div>

<div class="card showcase-demo-card border-0 shadow-lg">
  <div class="card-header showcase-demo-header d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 p-md-4">
    <span class="small text-body-secondary">DESIGN EXAMPLE</span>
    <ul class="nav nav-pills showcase-quality-tabs" id="<%= key %>-quality-tabs" role="tablist" aria-label="Choose good or bad <%= title.downcase %> design">
      <li class="nav-item" role="presentation">
        <button class="nav-link showcase-good-tab active" id="<%= key %>-good-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-good" type="button" role="tab" aria-controls="<%= key %>-good" aria-selected="true">
          <svg class="showcase-quality-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 3a3.13 3.13 0 0 1 3 2.88Z"/></svg>
          <span>Good</span>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link showcase-bad-tab" id="<%= key %>-bad-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-bad" type="button" role="tab" aria-controls="<%= key %>-bad" aria-selected="false">
          <svg class="showcase-quality-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 21a3.13 3.13 0 0 1-3-2.88Z"/></svg>
          <span>Bad</span>
        </button>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <section class="tab-pane fade show active p-3 p-md-4" id="<%= key %>-good" role="tabpanel" aria-labelledby="<%= key %>-good-tab" tabindex="0">
      <div class="row g-4 align-items-stretch">
        <div class="col-12 col-md-7">
          <div class="showcase-preview h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="showcase-status-dot showcase-status-good"></span>
              <span class="small text-body-secondary">GOOD DESIGN</span>
            </div>
            <h3 class="h5 mb-1"><%= good_title %></h3>
            <p class="small text-body-secondary mb-4"><%= good_description %></p>
            <%= yield %>
          </div>
        </div>
        <div class="col-12 col-md-5">
          <div class="showcase-takeaway h-100 p-3 p-lg-4 rounded-4">
            <span class="showcase-takeaway-icon mb-3" aria-hidden="true">✦</span>
            <h4 class="h6">Why it works</h4>
            <p class="small text-body-secondary mb-0"><%= lesson %></p>
          </div>
        </div>
      </div>
    </section>

    <section class="tab-pane fade p-3 p-md-4" id="<%= key %>-bad" role="tabpanel" aria-labelledby="<%= key %>-bad-tab" tabindex="0">
      <div class="row g-4 align-items-stretch">
        <div class="col-12 col-md-7">
          <div class="showcase-preview demo-bad h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="showcase-status-dot showcase-status-bad"></span>
              <span class="small">BAD DESIGN</span>
            </div>
            <h3 class="h5 mb-1"><%= bad_title %></h3>
            <p class="small mb-4"><%= bad_description %></p>
            <% case key %>
            <% when "inputs" %>
              <div class="demo-bad-form">
                <span>PUT EMAIL HERE!!!</span>
                <input type="text" aria-label="Unlabeled email field">
                <button type="button">GO!!!</button>
                <p>Did it work? Maybe. Who knows.</p>
              </div>
              <h4 class="h6 mt-4">Hard-to-target checkbox</h4>
              <div class="demo-checkbox-bad mt-2">
                <input id="bad-remember" type="checkbox" aria-label="Keep me signed in">
                <span>Keep me signed in <small>(only the tiny box works)</small></span>
              </div>
            <% when "styling" %>
              <div class="demo-style-bad p-4 rounded-4">
                <p>*** URGENT IMPORTANT NOTICE ***</p>
                <h3>CLICK THIS BUTTON RIGHT NOW</h3>
                <button type="button">CLICK!!!</button>
                <button type="button">NO WAIT CLICK THIS</button>
                <p>everything is important so nothing is important</p>
              </div>
            <% when "images" %>
              <div class="demo-art-bad" role="img" aria-label="Distorted abstract image with clashing colors and an awkward crop">
                <div class="demo-art-bad-shape"></div>
              </div>
              <p class="small mt-2 mb-0">Image_final_FINAL2_new.jpg (maybe)</p>
            <% else %>
              <div class="demo-elements-bad">
                <div>WARNING!!! ACTION NEEDED!!!</div>
                <div>SUCCESS? ERROR? PLEASE WAIT?</div>
                <div>CLICK HERE TO CONTINUE OR MAYBE NOT</div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-12 col-md-5">
          <div class="showcase-takeaway showcase-takeaway-bad h-100 p-3 p-lg-4 rounded-4">
            <span class="showcase-takeaway-icon mb-3" aria-hidden="true">!</span>
            <h4 class="h6">What makes this harder?</h4>
            <p class="small mb-0">Unclear hierarchy and missing context make people stop, guess, or give up. The fix is usually to make the next step more obvious.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
