<form class="demo-input-form demo-retro-kit" data-controller="bad-input">
  <section class="demo-retro-panel demo-retro-main-fields" data-section-number="1">
    <div><input name="first_name" aria-label="Name" class="demo-retro-input demo-retro-focused" type="text" data-action="input->bad-input#rewrite"></div>
    <div><input name="last_name" aria-label="Last name" class="demo-retro-input" type="text" data-action="input->bad-input#rewrite"></div>
    <div><input name="username" aria-label="Username" class="demo-retro-input" type="text" data-action="input->bad-input#rewrite"></div>
    <div><input name="email" aria-label="Email" class="demo-retro-input" type="email" data-action="input->bad-input#rewrite"></div>
  </section>

  <div class="demo-retro-sections">
    <section class="demo-retro-panel demo-retro-unreachable-fields" data-section-number="2">
      <input name="phone" aria-label="Phone" class="demo-retro-input demo-retro-unreachable" type="tel" disabled>
      <input name="address" aria-label="Address" class="demo-retro-input demo-retro-unreachable" type="text" disabled>
      <input name="language" aria-label="Language" class="demo-retro-input demo-retro-unreachable" type="text" disabled>
    </section>

    <section class="demo-retro-panel demo-retro-options" aria-label="Options" data-section-number="3">
      <% 10.times do |index| %>
        <input name="option_<%= index + 1 %>" aria-label="Option <%= index + 1 %>" type="checkbox">
      <% end %>
    </section>

    <section class="demo-retro-panel demo-retro-actions" aria-label="Actions" data-section-number="4">
      <button type="button" disabled>Flibber</button>
      <button type="button" disabled><img src="data:image/gif;base64,broken" alt="Save"></button>
    </section>
  </div>
</form>
