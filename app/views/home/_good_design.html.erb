<section class="tab-pane fade show active p-3 p-md-4" id="<%= key %>-good" role="tabpanel" aria-labelledby="<%= key %>-good-tab" tabindex="0">
  <ul class="nav nav-tabs showcase-explanation-tabs" role="tablist" aria-label="Good design example and explanation">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="<%= key %>-good-example-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-good-example" type="button" role="tab" aria-controls="<%= key %>-good-example" aria-selected="true">Good Design</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="<%= key %>-good-why-tab" data-bs-toggle="tab" data-bs-target="#<%= key %>-good-why" type="button" role="tab" aria-controls="<%= key %>-good-why" aria-selected="false">Why?</button>
    </li>
  </ul>

  <div class="tab-content showcase-explanation-content">
    <div class="tab-pane fade show active" id="<%= key %>-good-example" role="tabpanel" aria-labelledby="<%= key %>-good-example-tab" tabindex="0">
      <div class="showcase-preview">
        <h3 class="h5 mb-1"><%= title %></h3>
        <p class="small text-body-secondary mb-4"><%= description %></p>
        <%= content %>
      </div>
    </div>
    <div class="tab-pane fade" id="<%= key %>-good-why" role="tabpanel" aria-labelledby="<%= key %>-good-why-tab" tabindex="0">
      <div class="showcase-takeaway p-3 p-lg-4 rounded-bottom-3">
        <span class="showcase-takeaway-icon mb-3" aria-hidden="true">✦</span>
        <h3 class="h5">Why it works</h3>
        <p class="text-body-secondary mb-0"><%= lesson %></p>
      </div>
    </div>
  </div>
</section>
