<header class="container site-header d-flex flex-wrap justify-content-between align-items-center gap-3 py-4">
  <%= link_to root_path, class: "showcase-brand text-decoration-none" do %>
    <span class="showcase-brand-mark" aria-hidden="true">G</span>
    <span>Good <span class="text-info">Vs</span> Evil</span>
  <% end %>

  <nav class="nav nav-pills showcase-top-nav align-items-center" aria-label="Main navigation">
    <% if controller_name == "home" %>
      <div class="nav-item d-flex" role="group" aria-label="Choose design quality">
        <button id="good-quality-toggle" class="nav-link showcase-good-tab active" type="button" data-design-quality="good" aria-pressed="true" onclick="showDesignQuality('good')">Good</button>
        <button id="bad-quality-toggle" class="nav-link showcase-bad-tab" type="button" data-design-quality="bad" aria-pressed="false" onclick="showDesignQuality('bad')">Bad</button>
      </div>
    <% end %>
    <%= link_to "Users", users_path, class: "nav-link#{' active' if controller_name == 'users'}", aria: { current: ("page" if controller_name == 'users') } %>
  </nav>
</header>
