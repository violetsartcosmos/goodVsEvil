<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
      <div class="card bg-black border border-light border-opacity-10 shadow-lg">
        <div class="card-body p-4">
          <h1 class="card-title h3 text-center mb-4">Login</h1>
          <%= form_with url: sessions_path, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email, class: "form-control", autocomplete: "email" %>
            </div>
            <div class="mb-4">
              <%= form.label :password, class: "form-label" %>
              <%= form.password_field :password, class: "form-control", autocomplete: "current-password" %>
            </div>
            <%= form.submit "Log in", class: "btn btn-primary w-100" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>